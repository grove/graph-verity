Compare ::= ("\"eq\"" | "\"ne\"" | "\"lt\"" | "\"le\"" | "\"gt\"" | "\"ge\"") space
Direction ::= ("\"forward\"" | "\"reverse\"") space
Filter ::= "{" space Filter-op-kv "," space Filter-value-kv "," space Filter-variable-kv "}" space
Filter-op ::= Compare
Filter-op-kv ::= "\"op\"" space ":" space Filter-op
Filter-value ::= Value
Filter-value-kv ::= "\"value\"" space ":" space Filter-value
Filter-variable-kv ::= "\"variable\"" space ":" space string
Having ::= "{" space Having-alias-kv "," space Having-op-kv "," space Having-value-kv "}" space
Having-alias-kv ::= "\"alias\"" space ":" space string
Having-op ::= Compare
Having-op-kv ::= "\"op\"" space ":" space Having-op
Having-value ::= ([0] | [1-9] [0-9]{0,15}) space
Having-value-kv ::= "\"value\"" space ":" space Having-value
Node ::= Node-0 | Node-1 | Node-2
Node-0 ::= "{" space Node-0-kind-kv "," space Node-0-name-kv "}" space
Node-0-kind ::= "\"variable\"" space
Node-0-kind-kv ::= "\"kind\"" space ":" space Node-0-kind
Node-0-name-kv ::= "\"name\"" space ":" space string
Node-1 ::= "{" space Node-1-iri-kv "," space Node-1-kind-kv "}" space
Node-1-iri-kv ::= "\"iri\"" space ":" space string
Node-1-kind ::= "\"iri\"" space
Node-1-kind-kv ::= "\"kind\"" space ":" space Node-1-kind
Node-2 ::= "{" space Node-2-kind-kv "," space Node-2-value-kv "}" space
Node-2-kind ::= "\"literal\"" space
Node-2-kind-kv ::= "\"kind\"" space ":" space Node-2-kind
Node-2-value ::= Value
Node-2-value-kv ::= "\"value\"" space ":" space Node-2-value
Pattern ::= "{" space Pattern-direction-kv "," space Pattern-from-kv "," space Pattern-graph-kv "," space Pattern-predicate-kv "," space Pattern-to-kv "}" space
Pattern-direction ::= Direction
Pattern-direction-kv ::= "\"direction\"" space ":" space Pattern-direction
Pattern-from ::= Node
Pattern-from-kv ::= "\"from\"" space ":" space Pattern-from
Pattern-graph-kv ::= "\"graph\"" space ":" space string
Pattern-predicate-kv ::= "\"predicate\"" space ":" space string
Pattern-to ::= Node
Pattern-to-kv ::= "\"to\"" space ":" space Pattern-to
Plan ::= "{" space Plan-filters-kv "," space Plan-group-by-kv "," space Plan-having-kv "," space Plan-limit-kv "," space Plan-patterns-kv "," space Plan-projection-kv "," space Plan-scope-kv "," space Plan-snapshot-id-kv "," space Plan-version-kv "}" space
Plan-filters ::= "[" space (Plan-filters-item ("," space Plan-filters-item)*)? "]" space
Plan-filters-item ::= Filter
Plan-filters-kv ::= "\"filters\"" space ":" space Plan-filters
Plan-group-by ::= "[" space (string ("," space string)*)? "]" space
Plan-group-by-kv ::= "\"group_by\"" space ":" space Plan-group-by
Plan-having ::= "[" space (Plan-having-item ("," space Plan-having-item)*)? "]" space
Plan-having-item ::= Having
Plan-having-kv ::= "\"having\"" space ":" space Plan-having
Plan-limit ::= ([0] | [1-9] [0-9]{0,15}) space
Plan-limit-kv ::= "\"limit\"" space ":" space Plan-limit
Plan-patterns ::= "[" space (Plan-patterns-item ("," space Plan-patterns-item)*)? "]" space
Plan-patterns-item ::= Pattern
Plan-patterns-kv ::= "\"patterns\"" space ":" space Plan-patterns
Plan-projection ::= "[" space (Plan-projection-item ("," space Plan-projection-item)*)? "]" space
Plan-projection-item ::= Projection
Plan-projection-kv ::= "\"projection\"" space ":" space Plan-projection
Plan-scope ::= "[" space (string ("," space string)*)? "]" space
Plan-scope-kv ::= "\"scope\"" space ":" space Plan-scope
Plan-snapshot-id-kv ::= "\"snapshot_id\"" space ":" space string
Plan-version ::= ([0] | [1-9] [0-9]{0,15}) space
Plan-version-kv ::= "\"version\"" space ":" space Plan-version
Projection ::= Projection-0 | Projection-1
Projection-0 ::= "{" space Projection-0-kind-kv "," space Projection-0-name-kv "}" space
Projection-0-kind ::= "\"variable\"" space
Projection-0-kind-kv ::= "\"kind\"" space ":" space Projection-0-kind
Projection-0-name-kv ::= "\"name\"" space ":" space string
Projection-1 ::= "{" space Projection-1-alias-kv "," space Projection-1-kind-kv "," space Projection-1-variable-kv "}" space
Projection-1-alias-kv ::= "\"alias\"" space ":" space string
Projection-1-kind ::= "\"count_distinct\"" space
Projection-1-kind-kv ::= "\"kind\"" space ":" space Projection-1-kind
Projection-1-variable-kv ::= "\"variable\"" space ":" space string
Proposal ::= Proposal-0 | Proposal-1 | Proposal-2 | Proposal-3
Proposal-0 ::= "{" space Proposal-0-plan-kv "," space Proposal-0-status-kv "}" space
Proposal-0-plan ::= Plan
Proposal-0-plan-kv ::= "\"plan\"" space ":" space Proposal-0-plan
Proposal-0-status ::= "\"candidate\"" space
Proposal-0-status-kv ::= "\"status\"" space ":" space Proposal-0-status
Proposal-1 ::= "{" space Proposal-1-reason-kv "," space Proposal-1-status-kv "}" space
Proposal-1-reason-kv ::= "\"reason\"" space ":" space string
Proposal-1-status ::= "\"needs_clarification\"" space
Proposal-1-status-kv ::= "\"status\"" space ":" space Proposal-1-status
Proposal-2 ::= "{" space Proposal-2-reason-kv "," space Proposal-2-status-kv "}" space
Proposal-2-reason-kv ::= "\"reason\"" space ":" space string
Proposal-2-status ::= "\"unsupported\"" space
Proposal-2-status-kv ::= "\"status\"" space ":" space Proposal-2-status
Proposal-3 ::= "{" space Proposal-3-code-kv "," space Proposal-3-message-kv "," space Proposal-3-status-kv "}" space
Proposal-3-code-kv ::= "\"code\"" space ":" space string
Proposal-3-message-kv ::= "\"message\"" space ":" space string
Proposal-3-status ::= "\"parsing_error\"" space
Proposal-3-status-kv ::= "\"status\"" space ":" space Proposal-3-status
Value ::= "{" space Value-datatype-kv "," space Value-lexical-kv ( "," space ( Value-language-kv ) )? "}" space
Value-datatype-kv ::= "\"datatype\"" space ":" space string
Value-language ::= string | null
Value-language-kv ::= "\"language\"" space ":" space Value-language
Value-lexical-kv ::= "\"lexical\"" space ":" space string
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
null ::= "null" space
proposal ::= Proposal
proposal-kv ::= "\"proposal\"" space ":" space proposal
root ::= "{" space proposal-kv "," space version-kv "}" space
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\"" space
version ::= ([0] | [1-9] [0-9]{0,15}) space
version-kv ::= "\"version\"" space ":" space version
