		wikibase:BestRank ;
	wikibase:rank wikibase:NormalRank ;
	ps:P2559 "Додайте найбільш локальну адміністративну територію (території), але переконайтесь, що той елемент також має P131, і т.д."@uk .

wd:P131 p:P2559 wds:P131-5ff92bb5-4353-cb2f-e99b-1a860c50d750 .

