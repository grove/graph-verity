wd:P17 p:P2302 wds:P17-414814BF-450D-4312-8A1B-F7D2005E4785 .

wds:P17-414814BF-450D-4312-8A1B-F7D2005E4785 a wikibase:Statement,
		wikibase:BestRank ;
	wikibase:rank wikibase:NormalRank ;
	ps:P2302 wd:Q52558054 ;
	pq:P2305 wd:Q22890 ;
	pq:P9729 wd:Q27,
		wd:Q145,
		wd:Q174193,
		wd:Q31747,
		wd:Q215530 ;
	pq:P6607 "For modern use (after 1937), use (Republic of) Ireland or United Kingdom respectively. For the period between 1922 and 1937, United Kingdom and/or Irish Free State may be applicable. For more information about this subject, as well as earlier time periods, check out [[:en:wp:Irish nationality law]] and [[:en:wp:British nationality law and the Republic of Ireland]]."@en,
		"对于现代（1937 年以后）的情况，请分别使用爱尔兰（共和国）或联合王国。对于 1922 年至 1937 年期间，联合王国和/或爱尔兰自由邦均适用。有关此主题以及更早时期的情况，请参阅维基百科条目“爱尔兰国籍法”和“英国国籍法与爱尔兰共和国”。"@zh ;
	pq:P2316 wd:Q21502408 .

wd:P17 p:P2302 wds:P17-8E63756C-12FB-426A-9402-C5CEA51B8CA6 .

